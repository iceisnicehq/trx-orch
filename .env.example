TRON_MODE=live
WEB_PORT=8080
WEB_BIND_HOST=127.0.0.1
TRON_FULL_HOST=https://api.trongrid.io
TRON_PRO_API_KEY=
ADMIN_PASSWORD=
# Optional Telegram channel notifications. Leave all three blank to disable.
# Token comes from @BotFather; never put it in wallets.json or the web client.
TELEGRAM_BOT_TOKEN=
# Numeric channel ID (often -100...) or a public channel @username.
TELEGRAM_CHANNEL_ID=
# ID of a text post that the bot can edit; pin that post in the channel.
TELEGRAM_PINNED_MESSAGE_ID=
# Optional HTTPS URL to the dashboard if it is reachable by channel members.
TELEGRAM_DASHBOARD_URL=
# To practice without real TRX, explicitly change TRON_MODE to mock.
