generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Wallet {
  address            String @id
  ordinal            Int @unique
  autoApprove        Boolean @default(false)
  mixEnabled         Boolean @default(false)
  joined             Boolean @default(false)
  entryBalanceSun    Int?
  balanceSnapshotSun Int @default(1000000)
  transfersOut       Transfer[] @relation("out")
}

model Transfer {
  id         String @id @default(cuid())
  sequence   Int @unique
  kind       String // MIX, RETURN (attributed stakes), REBALANCE (legacy), PAYOUT
  status     String // PLANNED, APPROVED, SUBMITTING, SUBMITTED, CONFIRMED, CANCELLED, PAUSED, UNKNOWN
  from       String
  to         String
  amountSun  Int
  scheduledAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  txId       String? @unique
  signedJson String? // same signed transaction for audit and crash recovery; never expose to clients
  note       String?
  bandwidthUsed Int? // actual Bandwidth reported in the confirmed on-chain receipt
  confirmedAt DateTime? // block timestamp, not the later time receipt polling completed
  pacingAfterId String? // confirmed predecessor used for the persisted random gap
  pacingDelayMs Int?
  resourceReadyAt DateTime? // adaptive MIX: first live check that met the required free quota
  resourceCheckAt DateTime? // durable, bounded next live resource probe; never a send permission
  resourceRequired Int? // larger signed transaction requirement discovered during preflight
  approvalSource String? // MANUAL or AUTO; disabling Auto revokes only unsent AUTO approvals
  campaignId String?
  campaignDay Int?
  plannedAt DateTime? // immutable original time; scheduledAt may move after resource checks
  dependsOnId String?
  allocations Allocation[]
  campaign Campaign? @relation(fields:[campaignId],references:[id])
  sender     Wallet @relation("out",fields:[from],references:[address])
  @@index([status,sequence])
  @@index([campaignId,sequence])
}

model EngineState {
  id              Int @id @default(1)
  phase           String @default("IDLE") // CAMPAIGN, CAMPAIGN_RETURN_REQUESTED, CAMPAIGN_RETURNING, CAMPAIGN_RESTORED; legacy phases; SETTLING, COMPLETE, HALTED
  status          String @default("Ready. Start to create a 24-hour plan.") // legacy DB default; init sets the current status explicitly
  teacherAddress  String
  teacherBaseline Int
  nextSequence    Int @default(1)
  lastPlanAt      DateTime?
  mixAmountMode   String @default("RANDOM") // SMART for campaigns; RANDOM/LIST retained for old records
  mixAmountList   String @default("[1000000,500000]") // exact Sun amounts, JSON
  mixAmountCursor Int @default(0) // advances only after a confirmed LIST transfer
  mixLastReceiver String? // next preferred sender for the LIST chain
  rebalanceFromSequence Int? // first sequence in this rebalance batch
  settlementFromSequence Int? // first sequence in this end-game batch
  fatalReason     String?
  haltedFromPhase String? // durable pre-HALT phase; used only for guarded reserve recovery
  selectedPlanVariantId String? // saved preview, no approval or broadcasting until Start
  activeCampaignId String?
  teacherConfigAddress String? // bootstrap config address; DB overrides survive a read-only config mount
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id String @id @default(cuid())
  planVariantId String?
  planVariant PlanVariant? @relation(fields:[planVariantId],references:[id],onDelete:SetNull)
  seed String
  version Int @default(1)
  status String @default("ACTIVE") // ACTIVE, RETURN_REQUESTED, RETURNING, RESTORED, PAID
  startedAt DateTime
  deadlineAt DateTime
  mixingDays Int
  totalDays Int
  executionStartedAt DateTime? // irreversible preparation lock, including failed signing/broadcast retries
  timingMode String @default("DAILY") // DAILY or BANDWIDTH; routes and allocations stay frozen
  timingUpdatedAt DateTime? // latest resource-based forecast, not an execution guarantee
  returnReason String?
  payAfterReturn Boolean @default(false)
  createdAt DateTime @default(now())
  members CampaignMember[]
  transfers Transfer[]
  positions OwnershipBalance[]
}

model CampaignMember {
  campaignId String
  address String
  ordinal Int
  profileJson String
  campaign Campaign @relation(fields:[campaignId],references:[id])
  @@id([campaignId,address])
}

// This records attribution, not identifiable coins on TRON. One native
// transfer may carry contributions from several members.
model Allocation {
  transferId String
  ownerAddress String
  amountSun Int
  transfer Transfer @relation(fields:[transferId],references:[id])
  @@id([transferId,ownerAddress])
  @@index([ownerAddress])
}

// Confirmed ownership only. Updated atomically with a zero-fee receipt.
model OwnershipBalance {
  campaignId String
  ownerAddress String
  holderAddress String
  amountSun Int
  campaign Campaign @relation(fields:[campaignId],references:[id])
  @@id([campaignId,ownerAddress,holderAddress])
}

model Audit {
  id        Int @id @default(autoincrement())
  at        DateTime @default(now())
  event     String
  detail    String
  transferId String?
  @@index([at])
}

// One cursor per Telegram channel. Its audit position is committed together
// with deliveries, so an API restart cannot silently skip an audit event.
model TelegramCursor {
  channelId          String @id
  pinnedMessageId    Int
  lastAuditId        Int @default(0)
  lastQueueHash      String?
  nextQueueAttemptAt DateTime?
  queueLastError     String?
  createdAt          DateTime @default(now())
}

model TelegramDelivery {
  id            String @id @default(cuid())
  channelId     String
  auditId       Int
  text          String
  status        String @default("PENDING") // PENDING, SENT
  priority      Int @default(0) // FATAL alerts go out before routine audit backlog
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  messageId     Int?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  @@unique([channelId,auditId])
  @@index([channelId,status,nextAttemptAt])
}

// Immutable preparation templates. Offsets are rebased only on explicit Start.
// Keys, approvals, signed transactions and receipts never enter these JSONs.
model PlanVariant {
  id String @id @default(cuid())
  number Int @unique
  membersJson String
  planJson String
  metricsJson String
  anchorAt DateTime
  deadlineAt DateTime
  totalDays Int
  generatorVersion Int @default(2)
  parentId String?
  sourceCampaignId String?
  createdAt DateTime @default(now())
  campaigns Campaign[]
}
